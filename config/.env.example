# ---- Geração de música (ElevenLabs Music) ----
ELEVENLABS_API_KEY=

# ---- Geração da imagem de fundo (Ideogram) ----
IDEOGRAM_API_KEY=

# ---- Animação do fundo (opcional, etapa 2b) ----
# Se preenchida, o fundo vira um loop animado curto (Runway image_to_video)
# em vez da imagem parada. Deixe em branco pra pular essa etapa e continuar
# com a imagem estática — o pipeline funciona normalmente sem isso.
RUNWAY_API_KEY=
RUNWAY_MODEL=gen4_turbo
RUNWAY_RATIO=720:1280

# ---- Texto na tela (título do mood) ----
# Caminho de uma fonte .ttf. Só precisa preencher se o padrão automático
# (Windows/Mac/Linux) não achar uma fonte no seu sistema.
CAPTION_FONT_FILE=

# ---- YouTube Live ----
# Pegue em studio.youtube.com > Criar > Transmitir ao vivo > Chave de transmissão
YOUTUBE_STREAM_KEY=
